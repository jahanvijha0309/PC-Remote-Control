<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Darkmode toggle"
        android:textColor="@color/text_label"
        android:textSize="20sp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/darkModeSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Joystick Sensitivity"
        android:textColor="@color/text_label"
        android:textSize="20sp" />

    <SeekBar
        android:id="@+id/sensitivitySeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progressTint="@color/tile_teal"
        android:thumbTint="@color/tile_teal" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Joystick Dead Zone"
        android:textColor="@color/text_label"
        android:textSize="20sp" />

    <SeekBar
        android:id="@+id/deadZoneSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="40"
        android:progressTint="@color/tile_teal"
        android:thumbTint="@color/tile_teal" />

    <TextView
        android:id="@+id/currentPcText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/text_subtitle"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/deviceStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/text_label"
        android:textSize="20sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/deviceListLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <ImageButton
        android:id="@+id/refreshButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_gray"
        android:contentDescription="Scan again"
        android:src="@drawable/ic_refresh"
        android:tint="@color/icon_gray" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/manageIpButton"
        style="@style/PillButton"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="manage ip´s"
        android:textSize="16sp"
        app:backgroundTint="@color/tile_indigo" />
</LinearLayout>
