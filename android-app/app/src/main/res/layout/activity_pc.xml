<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- screenshot | sound | close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/ControlLabel"
                    android:text="Screenshot" />

                <ImageButton
                    android:id="@+id/screenshotButton"
                    style="@style/ControlButton"
                    android:layout_width="56dp"
                    android:contentDescription="Take screenshot"
                    android:src="@drawable/ic_image" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/ControlLabel"
                    android:text="Sound" />

                <SeekBar
                    android:id="@+id/soundSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:maxHeight="40dp"
                    android:minHeight="40dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progress="50"
                    android:progressDrawable="@drawable/seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/ControlLabel"
                    android:text="close" />

                <ImageButton
                    android:id="@+id/closeButton"
                    style="@style/ControlButton"
                    android:contentDescription="Close program"
                    android:src="@drawable/ic_close" />
            </LinearLayout>
        </LinearLayout>

        <!-- mouse + scroll -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/ControlLabel"
                    android:text="Mouse" />

                <com.example.appington_city.ThumbstickView
                    android:id="@+id/thumbstick"
                    android:layout_width="230dp"
                    android:layout_height="230dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/ControlLabel"
                    android:text="Scroll" />

                <com.example.appington_city.VerticalSeekBar
                    android:id="@+id/scrollSeekBar"
                    android:layout_width="wrap_content"
                    android:layout_height="230dp"
                    android:max="100"
                    android:maxHeight="28dp"
                    android:minHeight="28dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progress="50"
                    android:progressDrawable="@drawable/seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb" />
            </LinearLayout>
        </LinearLayout>

        <!-- Left | Space | Right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/ControlLabel"
                    android:text="Left" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/leftButton"
                    style="@style/KeyButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="Left click"
                    android:padding="0dp"
                    android:text="L" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/ControlLabel"
                    android:text="Space" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/spaceButton"
                    style="@style/KeyButton"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:contentDescription="Space bar"
                    android:text="Space"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/ControlLabel"
                    android:text="Right" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rightButton"
                    style="@style/KeyButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="Right click"
                    android:padding="0dp"
                    android:text="R" />
            </LinearLayout>
        </LinearLayout>

        <!-- keyboard -->
        <TextView
            style="@style/ControlLabel"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="Keyboard" />

        <EditText
            android:id="@+id/keyboardInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="text input"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword|textNoSuggestions"
            android:maxLines="1"
            android:textColor="@color/text_title"
            android:textColorHint="@color/text_subtitle" />
    </LinearLayout>
</ScrollView>
