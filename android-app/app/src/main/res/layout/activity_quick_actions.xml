<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Quick Actions"
        android:textColor="@color/text_title"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Power actions ask for confirmation first"
        android:textColor="@color/text_subtitle"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/lockButton"
        style="@style/PillButton"
        android:layout_marginTop="16dp"
        android:text="Lock PC"
        app:backgroundTint="@color/tile_blue" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sleepButton"
        style="@style/PillButton"
        android:layout_marginTop="16dp"
        android:text="Sleep"
        app:backgroundTint="@color/tile_teal" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/restartButton"
        style="@style/PillButton"
        android:layout_marginTop="16dp"
        android:text="Restart"
        app:backgroundTint="@color/tile_amber" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/shutdownButton"
        style="@style/PillButton"
        android:layout_marginTop="16dp"
        android:text="Shut down"
        app:backgroundTint="@color/tile_red" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancelButton"
        style="@style/PillButton"
        android:layout_marginTop="16dp"
        android:text="Cancel restart / shutdown"
        app:backgroundTint="@color/tile_slate" />

</LinearLayout>
